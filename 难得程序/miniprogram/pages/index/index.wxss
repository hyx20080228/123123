.home { padding-top: 24rpx; }

/* ---------- 招牌 ---------- */
.hero {
  position: relative;
  height: 400rpx;
  border: 2rpx solid var(--nd-line);
  border-radius: 10rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 0 rgba(42, 36, 31, 0.05);
}
.hero__img { width: 100%; height: 100%; display: block; }
.hero__veil {
  position: absolute;
  left: 0; right: 0; bottom: 0; top: 0;
  background: linear-gradient(to bottom, rgba(36, 30, 26, 0.12) 0%, rgba(36, 30, 26, 0.05) 45%, rgba(36, 30, 26, 0.72) 100%);
}
.hero__plate {
  position: absolute;
  left: 28rpx;
  top: 26rpx;
  background: rgba(246, 239, 227, 0.92);
  border: 2rpx solid rgba(42, 36, 31, 0.5);
  border-radius: 6rpx;
  padding: 10rpx 20rpx 12rpx;
  text-align: center;
}
.hero__name {
  display: block;
  font-family: 'Songti SC', 'STSong', 'SimSun', serif;
  font-size: 38rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
  color: var(--nd-ink);
  line-height: 1.2;
}
.hero__en {
  display: block;
  font-size: 17rpx;
  letter-spacing: 5rpx;
  color: var(--nd-amber-deep);
  margin-top: 2rpx;
}
.hero__slogan {
  position: absolute;
  left: 30rpx;
  bottom: 26rpx;
  font-family: 'Songti SC', 'STSong', serif;
  font-size: 32rpx;
  letter-spacing: 5rpx;
  color: #FBF2E2;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.45);
}

/* ---------- 今晚 ---------- */
.tonight {
  margin-top: 26rpx;
  padding: 30rpx 30rpx 26rpx;
  background-image: radial-gradient(rgba(255, 220, 160, 0.07) 1px, transparent 1px);
  background-size: 18rpx 18rpx;
}
.tonight__tag {
  margin-left: 10rpx;
  font-size: 23rpx;
  letter-spacing: 4rpx;
  color: #E7C98C;
}
.tonight__date { font-size: 23rpx; color: #B2A28C; letter-spacing: 1rpx; }
.tonight__title {
  font-family: 'Songti SC', 'STSong', serif;
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  color: #FBF2E2;
  margin-top: 16rpx;
}
.tonight__artist {
  font-size: 26rpx;
  color: #E7C98C;
  letter-spacing: 2rpx;
  margin-top: 6rpx;
}
.tonight__meta {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #D9C7AD;
}
.tonight__dot { margin: 0 12rpx; color: #7E6E5A; }
.tonight__desc {
  margin-top: 14rpx;
  font-size: 23rpx;
  line-height: 1.7;
  color: #A4937D;
}
.tonight__styles { margin-top: 18rpx; }
.tonight__style {
  display: inline-block;
  border: 2rpx solid #5B4C3C;
  color: #C9A227;
  font-size: 20rpx;
  letter-spacing: 2rpx;
  padding: 2rpx 14rpx;
  border-radius: 4rpx;
}

/* ---------- 主按钮 ---------- */
.cta { margin-top: 32rpx; }
.cta__tip {
  text-align: center;
  margin-top: 16rpx;
  font-size: 21rpx;
  letter-spacing: 1rpx;
  color: var(--nd-ink-3);
}

/* ---------- 快捷 ---------- */
.quick {
  margin-top: 30rpx;
  display: flex;
  align-items: center;
  background: var(--nd-card);
  border: 2rpx solid var(--nd-line);
  border-radius: 10rpx;
  padding: 22rpx 0;
}
.quick__item { flex: 1; display: flex; flex-direction: column; align-items: center; }
.quick__text { margin-top: 8rpx; font-size: 22rpx; color: var(--nd-ink-2); letter-spacing: 1rpx; }
.quick__sep { width: 2rpx; height: 56rpx; background: var(--nd-line); }

/* ---------- 本周 ---------- */
.week { white-space: nowrap; width: 100%; }
.week__item {
  display: inline-block;
  width: 232rpx;
  vertical-align: top;
  margin-right: 18rpx;
  padding: 22rpx 20rpx;
  background: var(--nd-card);
  border: 2rpx solid var(--nd-line);
  border-radius: 10rpx;
  white-space: normal;
}
.week__item.is-closed { background: var(--nd-card-deep); opacity: 0.75; }
.week__day { font-size: 24rpx; font-weight: 600; letter-spacing: 2rpx; color: var(--nd-amber-deep); }
.week__md { font-size: 20rpx; color: var(--nd-ink-3); margin-top: 2rpx; }
.week__line {
  height: 2rpx;
  margin: 14rpx 0;
  background-image: linear-gradient(to right, var(--nd-line) 55%, transparent 0);
  background-size: 12rpx 2rpx;
}
.week__title {
  font-family: 'Songti SC', 'STSong', serif;
  font-size: 28rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}
.week__artist { font-size: 21rpx; color: var(--nd-ink-2); margin-top: 6rpx; min-height: 30rpx; }
.week__foot { font-size: 20rpx; color: var(--nd-ink-3); margin-top: 12rpx; }

/* ---------- 桌区 ---------- */
.zones { padding: 8rpx 28rpx; }
.zones__row {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 2rpx solid var(--nd-line);
}
.zones__row:last-child { border-bottom: none; }
.zones__badge {
  width: 56rpx; height: 56rpx;
  border: 2rpx solid var(--nd-amber);
  color: var(--nd-amber);
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-family: 'Songti SC', serif;
  font-size: 26rpx;
  font-weight: 700;
  margin-right: 20rpx;
  flex: none;
}
.zones__name { font-size: 28rpx; font-weight: 600; letter-spacing: 1rpx; }
.zones__count { font-size: 20rpx; color: var(--nd-ink-3); margin-left: 8rpx; font-weight: 400; }
.zones__desc { font-size: 22rpx; color: var(--nd-ink-2); margin-top: 4rpx; }
.zones__price { font-size: 22rpx; color: var(--nd-amber-deep); flex: none; }

/* ---------- 关于 ---------- */
.about__text { font-size: 25rpx; line-height: 1.9; color: var(--nd-ink-2); white-space: pre-line; }
.about__perf { margin: 26rpx -28rpx 10rpx; }
.about__cell { display: flex; align-items: center; padding: 16rpx 0; }
.about__cell-text { margin-left: 14rpx; font-size: 24rpx; color: var(--nd-ink-2); flex: 1; }

/* ---------- 须知 ---------- */
.notice {
  margin-top: 40rpx;
  padding: 28rpx;
  border: 2rpx dashed var(--nd-line);
  border-radius: 10rpx;
}
.notice__title {
  font-family: 'Songti SC', serif;
  font-size: 26rpx;
  letter-spacing: 4rpx;
  color: var(--nd-ink-2);
  margin-bottom: 12rpx;
}
.notice__item { display: flex; margin-top: 8rpx; }
.notice__dot { color: var(--nd-amber); margin-right: 12rpx; font-size: 22rpx; }
.notice__text { flex: 1; font-size: 22rpx; color: var(--nd-ink-3); line-height: 1.7; }
