/* ===========================================================
   难得民谣 · 全局样式（设计系统）
   风格关键词：牛皮纸 / 木头 / 暖灯 / 铅字印刷 / 票根
   =========================================================== */

page {
  --nd-paper: #F6EFE3;        /* 纸底 */
  --nd-card: #FDF9F0;         /* 卡片 */
  --nd-card-deep: #F0E5D2;    /* 次级底 */
  --nd-ink: #2A241F;          /* 墨色主文字 */
  --nd-ink-2: #6B6056;        /* 次级文字 */
  --nd-ink-3: #9C8B74;        /* 弱文字 */
  --nd-line: #E0D2BA;         /* 分割线 */
  --nd-amber: #C2743A;        /* 主色：威士忌 / 木吉他 */
  --nd-amber-deep: #A2562A;
  --nd-amber-soft: #F3E2CE;
  --nd-moss: #5F6B51;         /* 苔绿 */
  --nd-wine: #8C3B2E;         /* 酒红 */
  --nd-gold: #C9A227;
  --nd-night: #241E1A;        /* 夜色块 */

  background-color: var(--nd-paper);
  /* 纸张颗粒 */
  background-image:
    radial-gradient(rgba(122, 96, 58, 0.05) 1px, transparent 1px),
    radial-gradient(rgba(122, 96, 58, 0.035) 1px, transparent 1px);
  background-size: 14rpx 14rpx, 23rpx 23rpx;
  background-position: 0 0, 7rpx 11rpx;

  color: var(--nd-ink);
  font-size: 28rpx;
  line-height: 1.6;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', 'Microsoft YaHei', sans-serif;
}

view, text, input, textarea, scroll-view, navigator, button, image {
  box-sizing: border-box;
}

/* ---------- 文字 ---------- */
.nd-serif {
  font-family: 'Songti SC', 'STSong', 'SimSun', 'Noto Serif CJK SC', serif;
}
.nd-h1 {
  font-family: 'Songti SC', 'STSong', 'SimSun', serif;
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  color: var(--nd-ink);
}
.nd-h2 {
  font-family: 'Songti SC', 'STSong', 'SimSun', serif;
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}
.nd-en {
  font-size: 20rpx;
  letter-spacing: 6rpx;
  color: var(--nd-ink-3);
  text-transform: uppercase;
}
.nd-muted { color: var(--nd-ink-2); }
.nd-weak { color: var(--nd-ink-3); }
.nd-amber { color: var(--nd-amber); }
.nd-wine { color: var(--nd-wine); }
.nd-sm { font-size: 24rpx; }
.nd-xs { font-size: 21rpx; }
.nd-bold { font-weight: 600; }

/* ---------- 布局 ---------- */
.nd-page {
  min-height: 100vh;
  padding: 0 28rpx 180rpx;
}
.nd-row { display: flex; align-items: center; }
.nd-row-between { display: flex; align-items: center; justify-content: space-between; }
.nd-col { display: flex; flex-direction: column; }
.nd-grow { flex: 1; min-width: 0; }
.nd-gap-s { height: 16rpx; }
.nd-gap { height: 28rpx; }
.nd-gap-l { height: 48rpx; }

/* ---------- 卡片 ---------- */
.nd-card {
  background: var(--nd-card);
  border: 2rpx solid var(--nd-line);
  border-radius: 10rpx;
  padding: 28rpx;
  box-shadow: 0 6rpx 0 rgba(42, 36, 31, 0.04);
}
.nd-card-flat {
  background: var(--nd-card);
  border: 2rpx solid var(--nd-line);
  border-radius: 10rpx;
}
.nd-card-night {
  background: var(--nd-night);
  border-radius: 10rpx;
  color: var(--nd-paper);
  padding: 28rpx;
}
.nd-card-night .nd-muted { color: #BFAE97; }

/* 章节标题：✦ 标题 ——————— */
.nd-section {
  display: flex;
  align-items: center;
  margin: 44rpx 0 22rpx;
}
.nd-section__mark {
  color: var(--nd-amber);
  font-size: 22rpx;
  margin-right: 12rpx;
}
.nd-section__title {
  font-family: 'Songti SC', 'STSong', 'SimSun', serif;
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}
.nd-section__line {
  flex: 1;
  height: 2rpx;
  margin-left: 20rpx;
  background-image: linear-gradient(to right, var(--nd-line) 60%, transparent 0);
  background-size: 12rpx 2rpx;
  background-repeat: repeat-x;
}
.nd-section__extra {
  font-size: 23rpx;
  color: var(--nd-ink-3);
  margin-left: 16rpx;
}

/* ---------- 票根 ---------- */
.nd-ticket {
  position: relative;
  background: var(--nd-card);
  border: 2rpx solid var(--nd-line);
  border-radius: 10rpx;
  overflow: hidden;
}
.nd-ticket__body { padding: 28rpx; }
/* 撕口虚线：左右两个圆缺口 */
.nd-perf {
  position: relative;
  height: 2rpx;
  margin: 0 30rpx;
  background-image: linear-gradient(to right, var(--nd-line) 55%, transparent 0);
  background-size: 14rpx 2rpx;
  background-repeat: repeat-x;
}
.nd-perf::before,
.nd-perf::after {
  content: '';
  position: absolute;
  top: -16rpx;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: var(--nd-paper);
  border: 2rpx solid var(--nd-line);
}
.nd-perf::before { left: -46rpx; }
.nd-perf::after { right: -46rpx; }

/* ---------- 按钮 ---------- */
.nd-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 92rpx;
  border-radius: 8rpx;
  font-size: 30rpx;
  letter-spacing: 4rpx;
  font-weight: 600;
}
.nd-btn-main {
  background: var(--nd-amber);
  color: #FFF8EC;
  box-shadow: 0 6rpx 0 var(--nd-amber-deep);
}
.nd-btn-main:active { transform: translateY(3rpx); box-shadow: 0 3rpx 0 var(--nd-amber-deep); }
.nd-btn-ghost {
  background: transparent;
  color: var(--nd-ink);
  border: 2rpx solid var(--nd-ink);
}
.nd-btn-ghost:active { background: rgba(42, 36, 31, 0.06); }
.nd-btn-soft {
  background: var(--nd-amber-soft);
  color: var(--nd-amber-deep);
  border: 2rpx solid #E6CFB4;
}
.nd-btn-disabled {
  background: #DED3C2;
  color: #9C8B74;
  box-shadow: none;
}
.nd-btn-sm { height: 64rpx; font-size: 25rpx; padding: 0 28rpx; letter-spacing: 2rpx; }

/* ---------- 小标签 ---------- */
.nd-tag {
  display: inline-flex;
  align-items: center;
  height: 36rpx;
  padding: 0 12rpx;
  border-radius: 4rpx;
  font-size: 20rpx;
  letter-spacing: 1rpx;
  background: var(--nd-amber-soft);
  color: var(--nd-amber-deep);
  margin-right: 10rpx;
}
.nd-tag-moss { background: #E4E8DC; color: var(--nd-moss); }
.nd-tag-wine { background: #F2DED9; color: var(--nd-wine); }
.nd-tag-line { background: transparent; border: 2rpx solid var(--nd-line); color: var(--nd-ink-2); }

/* 状态印章 */
.nd-stamp {
  display: inline-flex;
  align-items: center;
  padding: 2rpx 14rpx;
  border: 3rpx solid var(--nd-amber);
  color: var(--nd-amber);
  border-radius: 6rpx;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
  transform: rotate(-6deg);
  opacity: 0.9;
}
.nd-stamp-moss { border-color: var(--nd-moss); color: var(--nd-moss); }
.nd-stamp-gray { border-color: #B9AB96; color: #B9AB96; }
.nd-stamp-wine { border-color: var(--nd-wine); color: var(--nd-wine); }

/* ---------- 图标 ---------- */
.nd-ic { width: 32rpx; height: 32rpx; flex: none; }
.nd-ic-s { width: 26rpx; height: 26rpx; flex: none; }
.nd-ic-l { width: 44rpx; height: 44rpx; flex: none; }

/* ---------- 列表行 ---------- */
.nd-cell {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 2rpx solid var(--nd-line);
}
.nd-cell:last-child { border-bottom: none; }
.nd-cell__label { margin-left: 18rpx; flex: 1; }

/* ---------- 底部固定操作栏 ---------- */
.nd-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 28rpx calc(20rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(251, 246, 236, 0.97);
  border-top: 2rpx solid var(--nd-line);
  display: flex;
  align-items: center;
  z-index: 50;
}

/* ---------- 空状态 ---------- */
.nd-empty {
  padding: 120rpx 0;
  text-align: center;
  color: var(--nd-ink-3);
}
.nd-empty__mark {
  font-family: 'Songti SC', serif;
  font-size: 56rpx;
  color: var(--nd-line);
  letter-spacing: 8rpx;
}

/* ---------- 页脚落款 ---------- */
.nd-foot {
  text-align: center;
  padding: 60rpx 0 20rpx;
  color: var(--nd-ink-3);
  font-size: 21rpx;
  letter-spacing: 3rpx;
}
