{
  "name": "my-story-studio",
  "version": "1.0.0",
  "description": "My Story Studio - AI Interactive Visual Novel Maker",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "electron .",
    "build": "npx tsc -p tsconfig.main.json && npx tsc -p tsconfig.preload.json",
    "start": "npm run build && electron .",
    "test": "node test-ui.js"
  },
  "dependencies": {
    "electron": "^32.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3"
  },
  "build": {
    "appId": "com.mystory.studio",
    "productName": "My Story Studio",
    "directories": {
      "app": "dist",
      "buildResources": "assets"
    },
    "files": ["dist/**/*", "assets/**/*"],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "assets/icons/icon.ico"
    }
  },
  "keywords": ["visual-novel", "story", "game-maker"],
  "author": "My Story Studio Team",
  "license": "MIT"
}
